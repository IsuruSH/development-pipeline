      "content": "from typing import Dict, Optional, Tuple\nimport hmac\nimport hashlib\nimport time\nimport random\nimport string\nfrom datetime import datetime\nfrom functools import lru_cache\nfrom typing_extensions import Literal\nfrom pydantic import BaseModel\nfrom fastapi.security import OAuth2PasswordBearer\nfrom jose import JWTError, jwt\nfrom passlib.context import CryptContext\n\ncrypto_context = CryptContext(schemes=['pbkdf2_sha256'], default='pbkdf2_sha256', deprecated='auto')\noauth2_scheme = OAuth2PasswordBearer(tokenUrl='/token')\n\nclass User(BaseModel):\n    id: int\n    email: str\n    password_hash: str\n\nusers: Dict[str, User] = {}\nlogin_attempts: Dict[str, int] = {}\nrate_limit_window: datetime = datetime.now()\nrate_limit_expires: datetime = rate_limit_window + timedelta(minutes=5)\n\ndef register_user(email: str, password: str) -> User:\n    if email in users:\n        raise ValueError('Duplicate-email error')\n    salt = ''.join(random.choices(string.ascii_letters + string.digits, k=16))\n    hashed_password = crypto_context.hash(password.encode(), salt=salt)\n    user = User(id=len(users) + 1, email=email.lower(), password_hash=hashed_password)\n    users[email] = user\n    return user\n\n@lru_cache(maxsize=None)\ndef login_user(email: str, password: str) -> Tuple[str, int]:\n    if email not in users:\n        raise ValueError('Invalid-credentials error')\n    user = users[email]\n    if crypto_context.verify(password.encode(), user.password_hash.encode()) == False:\n        raise ValueError('Invalid-credentials error')\n    token = generate_token(user.id)\n    return token, user.id\n\ndef rate_limit(email: str) -> None:\n    global login_attempts, rate_limit_window, rate_limit_expires\n    if email in login_attempts and time.time() < rate_limit_expires.timestamp():\n        raise ValueError('Rate-limit error')\n    login_attempts[email] = 1\n    rate_limit_window = datetime.now()\n    rate_limit_expires = rate_limit_window + timedelta(minutes=5)\n\ndef generate_token(user_id: int) -> str:\n    payload = {'sub': user_id, 'exp': time.time() + 3600}\n    return jwt.encode(payload, 'your_secret_key', algorithm='HS256')\n",
