# =============================================================================
# spec-pipeline — example environment configuration.
# Copy this file to `.env` and edit. The pipeline reads `.env` automatically
# via python-dotenv at startup.
# =============================================================================

# --- LLM provider selection --------------------------------------------------
# One of: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Model id. The exact string depends on the provider you picked above.
# Leave unset to use the per-provider default (qwen2.5-coder:1.5b / gpt-4o-mini /
# claude-sonnet-4-5).
LLM_MODEL=qwen2.5-coder:1.5b

# Base URL for OpenAI-compatible providers (ollama, openai, vllm, lmstudio,
# groq, together, anyscale, ...). Ignored for the anthropic provider.
# Defaults:
#   ollama  -> http://localhost:11434/v1
#   openai  -> https://api.openai.com/v1
LLM_BASE_URL=http://localhost:11434/v1

# API key. For ollama, any non-empty string works (default 'ollama').
# For openai / anthropic, this is required.
LLM_API_KEY=ollama


# --- Worked examples — pick ONE block and comment out the LLM_* lines above --

# ---- Ollama (local, free, what docker-compose uses by default) --------------
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:1.5b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
#
# Better small models for actual code generation (drop-in swap):
#   LLM_MODEL=qwen2.5-coder:1.5b   # ~986MB, good at JSON/code
#   LLM_MODEL=llama3.2:3b          # ~2GB, general purpose
#   LLM_MODEL=qwen2.5-coder:7b     # ~4.7GB, best small code model

# ---- OpenAI -----------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# ---- Anthropic --------------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# LLM_API_KEY=sk-ant-...
# (LLM_BASE_URL is ignored for anthropic)


# --- Pipeline behaviour ------------------------------------------------------

# Skip interactive approval prompts (intended for CI / docker-compose runs).
PIPELINE_AUTO_APPROVE=1

# Override the actor name recorded in the audit log (defaults to OS user).
# PIPELINE_ACTOR=alice@example.com

# Which spec to run when invoked without an argument (docker-compose default).
SPEC_FILE=specs/user_authentication.yaml
